# ---- storage (pick one) ----
STORAGE_BACKEND=file              # file | azure   (auto: azure if a connection string is set)
DATA_DIR=/data                    # file backend: persistent dir (Railway volume mount)
# AzureWebJobsStorage=...         # azure backend: storage connection string

# ---- LinkedIn (official API, w_member_social) ----
# Either set the token here, or store it in <posts-store>/li_secrets.json as {"access_token": "..."}
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VISIBILITY=PUBLIC

# ---- email check-in loop (Gmail app password; IMAP + SMTP) ----
GMAIL_USERNAME=you@gmail.com
GMAIL_APP_PASSWORD=
MAIL_TO=you+jobs@gmail.com

# ---- chat brain (Azure OpenAI / AI Foundry) — optional; also readable from li_secrets.json ----
AOAI_ENDPOINT=https://<resource>.services.ai.azure.com
AOAI_KEY=
AOAI_DEPLOYMENT=gpt-5.4-mini

# ---- posting knobs (also overridable from li_secrets.json / by emailing the bot) ----
LINKEDIN_CARDS_PER_COMPANY=10
LINKEDIN_JOBS_PER_CARD=4
LINKEDIN_SPACING_MIN=10
LINKEDIN_MAX_PER_DRAIN=1
LINKEDIN_DAILY_CAP=145
PORT=8080                         # worker.py health endpoint
